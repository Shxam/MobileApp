# IPL Dhaba Super App — Example Environment Configuration (.env.example)
#
# Copy to `.env` and fill in real values. The backend validates this list at
# boot (apps/backend/src/common/config/env.ts) and REFUSES TO START if a
# required secret is missing, too short, or set to a known-public placeholder.
#
# Generate a strong secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# ── Node Server ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# ── Frontend & API Base URL ──────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001
APP_URL=http://localhost:3000

# Comma-separated browser origins allowed to call the API. Required in
# production. Wildcards are not accepted.
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003,http://localhost:3004

# ── Authentication & JWT Security ────────────────────────────────────────────
# REQUIRED. Minimum 32 characters. Never reuse across environments.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
STAFF_TOKEN_TTL=12h

# Signs turf gate passes. REQUIRED in production, minimum 32 characters.
GATE_PASS_SECRET=

# ── PostgreSQL Database ──────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/ipldhaba"

# ── Redis ────────────────────────────────────────────────────────────────────
# REDIS_URL takes precedence. One of REDIS_URL / REDIS_HOST is required in
# production — the in-memory fallback is not safe across replicas.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Razorpay Payment Gateway ─────────────────────────────────────────────────
# REQUIRED in production. Use rzp_test_* keys in development.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Firebase Admin SDK (BACKEND PRIVATE — NEVER EXPOSE TO THE FRONTEND) ──────
GOOGLE_APPLICATION_CREDENTIALS=firebase-service-account.json
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Firebase Client Web SDK (PUBLIC FRONTEND CONFIGURATION) ──────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Operational Staff Access ─────────────────────────────────────────────────
# Seeded by `npm run seed:staff`. PINs are stored bcrypt-hashed in the
# database — there is no shared plaintext PIN environment variable.
KITCHEN_EMPLOYEE_ID="KITCHEN-001"
DELIVERY_EMPLOYEE_ID="DELIVERY-001"
ADMIN_EMPLOYEE_ID="ADMIN-001"

# ── Cricket Live Score API ───────────────────────────────────────────────────
# Optional. When unset, the live-score endpoint reports unavailable rather
# than inventing scores.
CRICKET_API_KEY=

# ── Misc ─────────────────────────────────────────────────────────────────────
DEFAULT_DHABA_ID=dhaba_singarayakonda
