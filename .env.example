# IPL Dhaba Super App — Example Environment Configuration (.env.example)

# Node Server Environment
NODE_ENV=development
PORT=3001

# Frontend & API Base URL
VITE_API_URL=http://localhost:3001
APP_URL=http://localhost:3000

# Authentication & JWT Security
JWT_SECRET=dev-jwt-secret-key-ipl-dhaba-2026
JWT_REFRESH_SECRET=dev-refresh-secret-key-ipl-dhaba-2026

# PostgreSQL Database
DATABASE_URL="postgresql://user:password@localhost:5432/ipldhaba"

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379

# Firebase Admin SDK (BACKEND PRIVATE CREDENTIALS - NEVER PUT IN FRONTEND)
GOOGLE_APPLICATION_CREDENTIALS=firebase-service-account.json
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase Client Web SDK (PUBLIC FRONTEND CONFIGURATION)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Operational Staff Access
KITCHEN_EMPLOYEE_ID="KITCHEN-001"
DELIVERY_EMPLOYEE_ID="DELIVERY-001"
ADMIN_EMPLOYEE_ID="ADMIN-001"
STAFF_PIN="CHANGE_THIS_TO_A_SECURE_PIN"
