{
  "name": "ipl-dhaba-super-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "//workspaces": [
    "Only the two shared libraries are workspaces. `apps/*` deliberately is not:",
    "apps/mobile is Expo (react 18.2 + react-native), and hoisting it into a tree",
    "whose web apps run react 19.2 would resolve two Reacts and break the",
    "customer build. The three browser staff apps (admin, kitchen-kds, driver)",
    "carry no manifest at all — they are Vite shells run from this root via the",
    "dev:*/build:* scripts below, sharing this dependency tree by design."
  ],
  "workspaces": [
    "packages/types",
    "packages/api-client"
  ],
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:backend": "tsx apps/backend/src/main.ts",
    "dev:kds": "vite apps/kitchen-kds --port=3002",
    "dev:driver": "vite apps/driver --port=3004",
    "dev:admin": "vite apps/admin --port=3003",
    "build": "vite build",
    "build:kds": "vite build apps/kitchen-kds",
    "build:driver": "vite build apps/driver",
    "build:admin": "vite build apps/admin",
    "build:backend": "prisma generate && tsc -p tsconfig.backend.json",
    "start:backend": "node dist/apps/backend/src/main.js",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "lint:backend": "tsc -p tsconfig.backend.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "test": "jest --config jest.config.cjs --runInBand",
    "test:e2e": "jest --config jest.config.cjs --runInBand"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/platform-ws": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.28",
    "@prisma/client": "^5.22.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/bcrypt": "^6.0.0",
    "@types/crypto-js": "^4.2.2",
    "@types/leaflet": "^1.9.22",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.3",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^5.0.4",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.0.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.2.0",
    "framer-motion": "^12.43.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "vite": "^6.2.3",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.28",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "ts-jest": "^29.4.12",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "uuid": "^14.0.1",
    "vite": "^6.2.3"
  },
  "overrides": {
    "uuid": "$uuid"
  }
}
