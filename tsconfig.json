{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // "test" is excluded below, so the `import '@testing-library/jest-dom'` in
    // test/jest.setup.dom.ts — which is what registers `toBeInTheDocument` and
    // friends on jest.Matchers — is never seen by tsc. Naming the package here
    // loads that augmentation for the specs under src/ instead.
    "types": ["vite/client", "node", "jest", "@testing-library/jest-dom"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": ["./*"]
    },
    "noEmit": true
  },
  "exclude": ["node_modules", "**/dist", "apps/mobile", "apps/backend", "test"]
}
